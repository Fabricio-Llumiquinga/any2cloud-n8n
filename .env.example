# Configuración de n8n Instance
N8N_API_URL=http://alb-n8n-1609613565.us-east-1.elb.amazonaws.com
N8N_API_KEY=tu-api-key-aqui

# Configuración MCP
MCP_MODE=stdio
LOG_LEVEL=error
DISABLE_CONSOLE_OUTPUT=true
WEBHOOK_SECURITY_MODE=moderate

# Telemetría (opcional)
N8N_MCP_TELEMETRY_DISABLED=false

# Base de datos (opcional)
SQLJS_SAVE_INTERVAL_MS=5000
